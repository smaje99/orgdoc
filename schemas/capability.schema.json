{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgdoc.dev/schemas/capability.schema.json",
  "title": "OrgDoc capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "description", "input_schema", "output_schema", "runtime", "entrypoint", "resource_class", "platforms", "permissions", "timeout_seconds", "max_output_bytes"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "input_schema": {"type": "string", "minLength": 1, "pattern": "^[^/].*$"},
    "output_schema": {"type": "string", "minLength": 1, "pattern": "^[^/].*$"},
    "runtime": {"enum": ["native", "python"]},
    "entrypoint": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resource_class": {"enum": ["cpu", "gpu", "memory"]},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["linux", "darwin", "windows"]}},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["filesystem:read_organization", "filesystem:read_input", "filesystem:write_artifact_dir", "filesystem:write_media_artifacts", "network"]}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 104857600}
  }
}
