{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgdoc.dev/schemas/operation.schema.json",
  "title": "OrgDoc operation profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "brand_id"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "brand_id": {"type": "string", "minLength": 1},
    "legal_name": {"type": "string"},
    "tax_id": {"type": "string"},
    "address": {"type": "string"}
  }
}
