{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgdoc.dev/schemas/document-type.schema.json",
  "title": "OrgDoc document type profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "required_fields", "protected_fields", "renderer_capability"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "required_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "protected_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "renderer_capability": {"type": "string", "minLength": 1}
  }
}
