{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgdoc.dev/schemas/brand.schema.json",
  "title": "OrgDoc brand profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "assets", "visual", "voice"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "assets": {"type": "array", "items": {"$ref": "organization.schema.json#/$defs/profilePath"}},
    "visual": {"type": "object", "minProperties": 1},
    "voice": {"type": "object", "minProperties": 1}
  }
}
