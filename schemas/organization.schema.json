{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgdoc.dev/schemas/organization.schema.json",
  "title": "OrgDoc organization profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "brands", "operations", "document_types"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "brands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profilePath"}},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profilePath"}},
    "document_types": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profilePath"}}
  },
  "$defs": {
    "profilePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*$"
    }
  }
}
