{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrgDoc PDF form generation input",
  "type": "object",
  "required": ["protocol_version", "job_id", "operation_id", "brand_id", "document_type", "input", "artifact_dir"],
  "properties": {
    "protocol_version": {"const": 1},
    "job_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "brand_id": {"type": "string", "minLength": 1},
    "document_type": {"const": "pdf-form"},
    "input": {
      "type": "object",
      "required": ["document", "context", "organization_root"],
      "properties": {
        "organization_root": {"type": "string", "minLength": 1},
        "context": {"type": "object", "required": ["organization", "operation", "brand", "document_type"]},
        "document": {"$ref": "#/$defs/document"}
      },
      "additionalProperties": false
    },
    "artifact_dir": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "textField": {
      "type": "object", "required": ["name", "type", "label", "x", "y", "width", "height"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}, "type": {"const": "text"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}, "x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "minimum": 20}, "height": {"type": "number", "minimum": 16}, "required": {"type": "boolean"},
        "max_length": {"type": "integer", "minimum": 1, "maximum": 4000}, "multiline": {"type": "boolean"}, "value": {"type": "string", "maxLength": 4000}
      },
      "additionalProperties": false
    },
    "checkboxField": {
      "type": "object", "required": ["name", "type", "label", "x", "y", "size"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}, "type": {"const": "checkbox"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}, "x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0},
        "size": {"type": "number", "minimum": 10}, "required": {"type": "boolean"}, "value": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "radioField": {
      "type": "object", "required": ["name", "type", "label", "x", "y", "options"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}, "type": {"const": "radio"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}, "x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0},
        "size": {"type": "number", "minimum": 10}, "gap": {"type": "number", "minimum": 22}, "required": {"type": "boolean"},
        "value": {"type": "string"}, "options": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "object", "required": ["value", "label"], "properties": {"value": {"type": "string", "minLength": 1, "maxLength": 64}, "label": {"type": "string", "minLength": 1, "maxLength": 80}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    },
    "choiceField": {
      "type": "object", "required": ["name", "type", "label", "x", "y", "width", "height", "options"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}, "type": {"const": "choice"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}, "x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "minimum": 20}, "height": {"type": "number", "minimum": 16}, "required": {"type": "boolean"},
        "value": {"type": "string"}, "options": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 120}}
      },
      "additionalProperties": false
    },
    "field": {"oneOf": [{"$ref": "#/$defs/textField"}, {"$ref": "#/$defs/checkboxField"}, {"$ref": "#/$defs/radioField"}, {"$ref": "#/$defs/choiceField"}]},
    "document": {
      "type": "object", "required": ["title", "fields"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 255}, "page_size": {"enum": ["A4", "Letter"]},
        "fields": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/field"}}
      },
      "additionalProperties": false
    }
  }
}
