{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrgDoc PDF form worker result",
  "type": "object",
  "required": ["protocol_version", "job_id", "status", "outputs", "field_summary", "diagnostics"],
  "properties": {
    "protocol_version": {"const": 1}, "job_id": {"type": "string"}, "status": {"enum": ["succeeded", "failed"]},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["path", "media_type"], "properties": {"path": {"type": "string"}, "media_type": {"const": "application/pdf"}}, "additionalProperties": false}},
    "field_summary": {"type": "array", "items": {"type": "object", "required": ["name", "type", "populated"], "properties": {"name": {"type": "string"}, "type": {"enum": ["text", "checkbox", "radio", "choice", "signature", "unsupported"]}, "populated": {"type": "boolean"}}, "additionalProperties": false}},
    "diagnostics": {"type": "array", "items": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
