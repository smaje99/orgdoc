{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrgDoc PDF form fill input",
  "type": "object",
  "required": ["protocol_version", "job_id", "operation_id", "brand_id", "document_type", "input", "artifact_dir"],
  "properties": {
    "protocol_version": {"const": 1}, "job_id": {"type": "string", "minLength": 1}, "operation_id": {"type": "string", "minLength": 1}, "brand_id": {"type": "string", "minLength": 1},
    "document_type": {"const": "pdf-form-fill"},
    "input": {"type": "object", "required": ["document", "context", "organization_root"], "properties": {
      "organization_root": {"type": "string", "minLength": 1}, "document": {"$ref": "#/$defs/document"},
      "context": {"type": "object", "required": ["organization", "operation", "brand", "document_type"]}
    }, "additionalProperties": false},
    "artifact_dir": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object", "required": ["template_path", "field_values"],
      "properties": {
        "template_path": {"type": "string", "minLength": 1},
        "field_values": {"type": "object", "additionalProperties": {"type": ["string", "boolean"]}},
        "flatten": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    }
  }
}
