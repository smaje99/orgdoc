{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invoice request",
  "type": "object",
  "additionalProperties": false,
  "required": ["invoice_number", "issue_date", "customer", "lines", "subtotal", "tax_total", "grand_total", "currency"],
  "properties": {
    "invoice_number": {"type": "string", "minLength": 1},
    "issue_date": {"type": "string", "format": "date"},
    "due_date": {"type": "string", "format": "date"},
    "customer": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "tax_id": {"type": "string"}, "address": {"type": "string"}}, "additionalProperties": false},
    "lines": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["description", "quantity", "unit_price", "tax_rate"], "properties": {"description": {"type": "string"}, "quantity": {"type": "number", "exclusiveMinimum": 0}, "unit_price": {"type": "number", "minimum": 0}, "tax_rate": {"type": "number", "minimum": 0}, "total": {"type": "number", "minimum": 0}}, "additionalProperties": false}},
    "subtotal": {"type": "number", "minimum": 0},
    "tax_total": {"type": "number", "minimum": 0},
    "grand_total": {"type": "number", "minimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
  }
}
