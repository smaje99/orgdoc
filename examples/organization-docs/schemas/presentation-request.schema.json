{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Branded presentation request",
  "$ref": "#/$defs/document",
  "$defs": {
    "titleBlock": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "title"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "additionalProperties": false
    },
    "sectionBlock": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "section"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "textBlock": {
      "type": "object",
      "required": [
        "type",
        "paragraphs"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "additionalProperties": false
    },
    "imageBlock": {
      "type": "object",
      "required": [
        "type",
        "asset_id",
        "alt_text"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "alt_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      },
      "additionalProperties": false
    },
    "tableBlock": {
      "type": "object",
      "required": [
        "type",
        "columns",
        "rows"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "chartBlock": {
      "type": "object",
      "required": [
        "type",
        "chart_type",
        "title",
        "categories",
        "series"
      ],
      "properties": {
        "type": {
          "const": "chart"
        },
        "chart_type": {
          "enum": [
            "bar",
            "line",
            "pie"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "categories": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "name",
              "values"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "values": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "number"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "contentBlock": {
      "oneOf": [
        {
          "$ref": "#/$defs/textBlock"
        },
        {
          "$ref": "#/$defs/imageBlock"
        },
        {
          "$ref": "#/$defs/tableBlock"
        },
        {
          "$ref": "#/$defs/chartBlock"
        }
      ]
    },
    "document": {
      "type": "object",
      "required": [
        "title",
        "slides"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "assets": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "validation": {
          "type": "object",
          "properties": {
            "render_pdf": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "layout",
                  "blocks"
                ],
                "properties": {
                  "layout": {
                    "const": "title"
                  },
                  "blocks": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "$ref": "#/$defs/titleBlock"
                      }
                    ],
                    "minItems": 1,
                    "maxItems": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "layout",
                  "blocks"
                ],
                "properties": {
                  "layout": {
                    "const": "section"
                  },
                  "blocks": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "$ref": "#/$defs/sectionBlock"
                      }
                    ],
                    "minItems": 1,
                    "maxItems": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "layout",
                  "blocks"
                ],
                "properties": {
                  "layout": {
                    "const": "content"
                  },
                  "blocks": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "$ref": "#/$defs/titleBlock"
                      },
                      {
                        "$ref": "#/$defs/contentBlock"
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "layout",
                  "blocks"
                ],
                "properties": {
                  "layout": {
                    "const": "two_column"
                  },
                  "blocks": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "$ref": "#/$defs/titleBlock"
                      },
                      {
                        "$ref": "#/$defs/contentBlock"
                      },
                      {
                        "$ref": "#/$defs/contentBlock"
                      }
                    ],
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
