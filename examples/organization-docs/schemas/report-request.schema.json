{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Narrative report request",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "source_references", "executive_summary", "findings"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "source_references": {"type": "array", "items": {"type": "string"}},
    "executive_summary": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["title", "evidence", "analysis"], "properties": {"title": {"type": "string"}, "evidence": {"type": "string"}, "analysis": {"type": "string"}}, "additionalProperties": false}},
    "quotations": {"type": "array", "items": {"type": "string"}},
    "citations": {"type": "array", "items": {"type": "string"}}
  }
}
